#!/usr/bin/env bash

# BUT DE CE SCRIPT : lancer Vagrant avec les bons réglages pour les ordinateurs
# de l'école. Utilisez `./bin/vagrant` à la place de la commande `vagrant`.

# En langage simple : trouve où ce script est rangé pour pouvoir utiliser le
# second wrapper `VBoxManage`, même si le projet est lancé depuis ailleurs.
# Retrouve le dossier bin/ même si la commande est lancée depuis un autre chemin.
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd -- "$script_dir/.." && pwd)"
if [[ -n ${REAL_VAGRANT:-} ]]; then
  real_vagrant="$REAL_VAGRANT"
elif [[ -x /usr/bin/vagrant ]]; then
  real_vagrant=/usr/bin/vagrant
elif [[ -x /usr/local/bin/vagrant ]]; then
  real_vagrant=/usr/local/bin/vagrant
elif [[ -x /opt/vagrant/bin/vagrant ]]; then
  real_vagrant=/opt/vagrant/bin/vagrant
else
  real_vagrant=""
fi

if [[ -n ${REAL_VBOXMANAGE:-} ]]; then
  real_vboxmanage="$REAL_VBOXMANAGE"
elif [[ -x /usr/bin/VBoxManage ]]; then
  real_vboxmanage=/usr/bin/VBoxManage
elif [[ -x /usr/local/bin/VBoxManage ]]; then
  real_vboxmanage=/usr/local/bin/VBoxManage
elif [[ -x /Applications/VirtualBox.app/Contents/MacOS/VBoxManage ]]; then
  real_vboxmanage=/Applications/VirtualBox.app/Contents/MacOS/VBoxManage
else
  real_vboxmanage=""
fi

if [[ -z "$real_vagrant" || -z "$real_vboxmanage" || ! -x "$real_vagrant" || ! -x "$real_vboxmanage" ]]; then
  printf 'Erreur : Vagrant et VirtualBox doivent être installés sur ce PC.\n' >&2
  exit 127
fi

# En langage simple : à l'école, chaque personne range ses grosses VM dans son
# propre dossier goinfre. Sur un PC personnel, VirtualBox garde son emplacement
# normal. La variable VAGRANT_VM_STORAGE permet aussi de choisir un autre disque.
goinfre_user_dir="/goinfre/${USER:-$(id -un)}"

# Le home des sessions de l'école est trop petit pour contenir les boxes.
# Utilise le dossier goinfre propre à l'utilisateur dès qu'il est accessible.
if [[ -z ${VAGRANT_HOME:-} && -d /goinfre ]]; then
  mkdir -p "$goinfre_user_dir/vagrant-home" 2>/dev/null || true
  if [[ -w "$goinfre_user_dir/vagrant-home" ]]; then
    export VAGRANT_HOME="$goinfre_user_dir/vagrant-home"
  fi
fi

if [[ -n ${VAGRANT_VM_STORAGE:-} ]]; then
  vm_storage="$VAGRANT_VM_STORAGE"
elif [[ -d /goinfre ]]; then
  mkdir -p "$goinfre_user_dir/iot-virtualbox" 2>/dev/null || true
  if [[ -w "$goinfre_user_dir/iot-virtualbox" ]]; then
    vm_storage="$goinfre_user_dir/iot-virtualbox"
  else
    vm_storage="$($real_vboxmanage list systemproperties | sed -n 's/^Default machine folder:[[:space:]]*//p')"
  fi
else
  vm_storage="$($real_vboxmanage list systemproperties | sed -n 's/^Default machine folder:[[:space:]]*//p')"
fi

if [[ ${1:-} == "up" ]]; then
  mkdir -p "$vm_storage"
  "$real_vboxmanage" setproperty machinefolder "$vm_storage"

  # Le nom utilisé dans le Vagrantfile est volontairement un alias local : il
  # garantit une image AMD64, alors que l'ancien Vagrant de l'école choisit
  # parfois l'image ARM64 du catalogue. Sur une nouvelle session, cet alias
  # n'existe pas encore ; on récupère donc automatiquement l'URL AMD64 actuelle
  # dans le catalogue officiel, puis on ajoute la box sous le bon nom.
  box_name="cloud-image/debian-13-vbox-amd64"
  if ! PATH="$script_dir:$PATH" REAL_VBOXMANAGE="$real_vboxmanage" \
      "$real_vagrant" box list 2>/dev/null \
      | sed 's/[[:space:]]*(.*$//' | grep -Fxq "$box_name"; then
    if ! command -v curl >/dev/null 2>&1; then
      printf 'Erreur : curl est nécessaire pour télécharger la box Debian AMD64.\n' >&2
      exit 127
    fi

    printf '[vagrant] Téléchargement de la box Debian 13 VirtualBox AMD64...\n'
    box_url="$(curl -fsSL \
      'https://vagrantcloud.com/api/v2/vagrant/cloud-image/debian-13' \
      | tr ',' '\n' \
      | sed -n 's/.*"url":"\([^"]*\/providers\/virtualbox\/amd64\/vagrant\.box\)".*/\1/p' \
      | head -n 1)"

    if [[ -z "$box_url" ]]; then
      printf 'Erreur : impossible de trouver la box VirtualBox AMD64 dans le catalogue.\n' >&2
      exit 1
    fi

    # L'ancien Vagrant interprète mal les redirections du nouveau catalogue.
    # Télécharger d'abord le fichier évite qu'il prenne l'archive pour du JSON.
    box_tmp_dir="${VAGRANT_HOME:-${TMPDIR:-/tmp}}"
    mkdir -p "$box_tmp_dir"
    box_tmp="$(mktemp "$box_tmp_dir/debian-13-amd64-XXXXXX.box")"
    if ! curl -fL "$box_url" -o "$box_tmp"; then
      rm -f -- "$box_tmp"
      printf 'Erreur : échec du téléchargement de la box Debian.\n' >&2
      exit 1
    fi
    if ! PATH="$script_dir:$PATH" REAL_VBOXMANAGE="$real_vboxmanage" \
        "$real_vagrant" box add --name "$box_name" "$box_tmp"; then
      rm -f -- "$box_tmp"
      exit 1
    fi
    rm -f -- "$box_tmp"
  fi

  # `.vagrant` décrit uniquement la VM locale. Si le projet a été déplacé,
  # copié depuis le compte d'un ami, ou si son disque a disparu, cet ancien
  # identifiant n'est plus valable et doit être oublié avant la recréation.
  state_dir="$project_dir/.vagrant/machines/default/virtualbox"
  state_id_file="$state_dir/id"
  state_cwd_file="$state_dir/vagrant_cwd"
  stale_state=false

  if [[ -f "$state_cwd_file" && $(<"$state_cwd_file") != "$project_dir" ]]; then
    stale_state=true
  fi
  if [[ -f "$state_id_file" ]]; then
    state_id="$(<"$state_id_file")"
    if ! "$real_vboxmanage" showvminfo "$state_id" --machinereadable >/dev/null 2>&1; then
      "$real_vboxmanage" unregistervm "$state_id" >/dev/null 2>&1 || true
      stale_state=true
    fi
  fi
  if [[ "$stale_state" == true ]]; then
    rm -rf -- "$state_dir"
  fi
fi

# En langage simple : avant de créer la VM, demande un disque de 40 Gio au lieu
# du petit disque de 10 Gio fourni par défaut dans l'image Debian.
# Vagrant 2.3 ne sait pas redimensionner un disque relié au contrôleur VirtIO.
# Avant une création, ajuste donc la capacité déclarée par la box elle-même.
if [[ ${1:-} == "up" ]]; then
  # Vagrant remplace le caractère / du nom de box par VAGRANTSLASH sur disque.
  box_ovf="${VAGRANT_HOME:-$HOME/.vagrant.d}/boxes/cloud-image-VAGRANTSLASH-debian-13-vbox-amd64/0/virtualbox/box.ovf"
  if [[ -f "$box_ovf" ]]; then
    # 42949672960 octets = 40 Gio. Cette valeur sera utilisée lors de l'import.
    sed -i 's/ovf:capacity="[0-9]*"/ovf:capacity="42949672960"/' "$box_ovf"
  fi
fi

# En langage simple : utilise notre adaptation locale et choisit VirtualBox.
# Pour les commandes ordinaires, il ne reste plus qu'à transmettre la demande.
if [[ ${1:-} != "up" ]]; then
  PATH="$script_dir:$PATH" VAGRANT_DEFAULT_PROVIDER=virtualbox \
    REAL_VBOXMANAGE="$real_vboxmanage" exec "$real_vagrant" "$@"
fi

# Lors d'une première création, VirtualBox importe parfois le VMDK avec sa taille
# d'origine de 10 Gio malgré la capacité indiquée dans l'OVF. On laisse l'import
# se terminer, puis on vérifie la vraie taille du disque créé.
PATH="$script_dir:$PATH" VAGRANT_DEFAULT_PROVIDER=virtualbox \
  REAL_VBOXMANAGE="$real_vboxmanage" "$real_vagrant" "$@"
first_status=$?

state_id_file="$project_dir/.vagrant/machines/default/virtualbox/id"
if [[ -f "$state_id_file" ]]; then
  state_id="$(<"$state_id_file")"
  disk_path="$($real_vboxmanage showvminfo "$state_id" --machinereadable 2>/dev/null \
    | sed -n 's/^"VirtIO Controller-0-0"="\(.*\)"$/\1/p')"

  if [[ -n "$disk_path" ]]; then
    disk_capacity="$($real_vboxmanage showmediuminfo disk "$disk_path" 2>/dev/null \
      | sed -n 's/^Capacity:[[:space:]]*\([0-9]*\) MBytes.*/\1/p')"
    if [[ -n "$disk_capacity" && "$disk_capacity" -lt 40960 ]]; then
      printf '\n[vagrant] Agrandissement automatique du disque à 40 Gio...\n'
      PATH="$script_dir:$PATH" VAGRANT_DEFAULT_PROVIDER=virtualbox \
        REAL_VBOXMANAGE="$real_vboxmanage" "$real_vagrant" halt
      "$real_vboxmanage" modifymedium disk "$disk_path" --resize 40960

      # Le redémarrage permet à Debian d'étendre sa partition. Le diagnostic
      # marqué « always » confirme ensuite que l'espace est bien disponible.
      PATH="$script_dir:$PATH" VAGRANT_DEFAULT_PROVIDER=virtualbox \
        REAL_VBOXMANAGE="$real_vboxmanage" exec "$real_vagrant" "$@"
    fi
  fi
fi

exit "$first_status"
